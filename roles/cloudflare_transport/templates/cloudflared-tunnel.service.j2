[Unit]
Description=Cloudflare Tunnel for the OpenVPN UDP relay
After=network-online.target gost-cloudflare-backend.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --no-autoupdate --protocol http2 tunnel run --token-file /etc/cloudflared/tunnel-token
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
