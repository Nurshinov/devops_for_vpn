map $ssl_preread_protocol $cloudflare_transport_backend {
  ""       openvpn_relay_backend;
  default  https_proxy_backend;
}

upstream openvpn_relay_backend {
  server 127.0.0.1:{{ secure_proxy_vpn_relay_port }};
}

upstream https_proxy_backend {
  server 127.0.0.1:{{ secure_proxy_backend_port }};
}

server {
  listen 127.0.0.1:{{ secure_proxy_cloudflare_origin_port }};
  ssl_preread on;
  proxy_connect_timeout 10s;
  proxy_timeout 1h;
  proxy_pass $cloudflare_transport_backend;
}
